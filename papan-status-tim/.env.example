# Diisi otomatis oleh Vercel saat kamu menghubungkan database KV/Redis
# ke project ini (lihat README.md bagian "Setup Database").
# Untuk development di komputer sendiri, jalankan `vercel env pull .env.local`
# setelah database terhubung di dashboard Vercel.

KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
